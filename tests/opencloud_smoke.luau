-- SkillCity headless production gate for Open Cloud Luau Execution.
-- No real purchases, visits, or player rewards are generated by this test.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local root = ReplicatedStorage:FindFirstChild("SkillCity")
assert(root ~= nil, "ReplicatedStorage.SkillCity missing")

local configModule = root:FindFirstChild("Config")
local mathModule = root:FindFirstChild("MathTasks")
assert(configModule and configModule:IsA("ModuleScript"), "Config module missing")
assert(mathModule and mathModule:IsA("ModuleScript"), "MathTasks module missing")

local Config = require(configModule)
local MathTasks = require(mathModule)
assert(type(Config.Version) == "string" and #Config.Version > 0, "invalid version")
assert(Config.Monetization.Enabled == false, "public MVP must remain fail-closed until paid grants are configured")

local sample = MathTasks.generate(Random.new(20260814))
assert(type(sample.prompt) == "string" and #sample.prompt > 0, "math prompt invalid")
assert(type(sample.answer) == "number" and sample.answer >= 0, "math answer invalid")
assert(type(sample.context) == "string" and #sample.context > 0, "math context invalid")

local server = ServerScriptService:FindFirstChild("SkillCityServer")
local services = ServerScriptService:FindFirstChild("Services")
assert(server and server:IsA("Script"), "SkillCityServer missing")
assert(services and services:IsA("Folder"), "Services folder missing")
for _, name in {"MapBuilder", "TrafficService", "JobService", "IncidentService", "PlayerDataService", "Analytics", "MonetizationService"} do
    local item = services:FindFirstChild(name)
    assert(item and item:IsA("ModuleScript"), name .. " service missing")
end

return {
    ok = true,
    version = Config.Version,
    monetizationEnabled = Config.Monetization.Enabled,
    sampledContext = sample.context,
}
